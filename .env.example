# Copy to `.env.local` and fill in. These same keys must also be set in the
# Vercel project's environment variables before deploying.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API

# Bare project URL — no trailing path. supabase-js appends /rest/v1, /auth/v1 itself.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (sb_publishable_…). Exposed to the browser; gated by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Secret key (sb_secret_…). Server-only, bypasses RLS. Never prefix NEXT_PUBLIC_.
# REQUIRED for the Stripe webhook: it has no user session, so RLS would reject
# every write it makes.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# ── Site ────────────────────────────────────────────────────────────────────
# Absolute origin used to build Stripe's success/cancel redirect URLs.
# Leave as localhost for development; set to the real domain in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe ──────────────────────────────────────────────────────────────────
# Developers → API keys. Use the TEST keys until you go live.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx

# Price IDs (NOT product IDs — they start with `price_`).
# Create one Product, "Digital Heroes Membership", with two recurring prices:
#   • monthly  — billing period: monthly
#   • yearly   — billing period: yearly, at a discount (PRD §04)
STRIPE_PRICE_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_YEARLY=price_xxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret (whsec_…).
#   Local:      stripe listen --forward-to localhost:3000/api/webhook
#               ...then copy the whsec_ it prints.
#   Deployed:   Developers → Webhooks → add endpoint https://<domain>/api/webhook
#               Events: checkout.session.completed,
#                       customer.subscription.created,
#                       customer.subscription.updated,
#                       customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx
